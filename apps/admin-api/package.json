{
  "name": "admin-api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "mikro-orm": {
    "useTsNode": true,
    "tsConfigPath": "./tsconfig.app.json"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "cross-env DOTENV_ENV=development dotenvx run --convention=nextjs -- nodemon --watch src -e ts --exec \"node esbuild.config.js && node --inspect dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "update:orm": "cross-env DOTENV_ENV=development dotenvx run --convention=nextjs -- mikro-orm migration:create",
    "update:db": "cross-env DOTENV_ENV=development dotenvx run --convention=nextjs -- mikro-orm migration:up",
    "setup:db": "cross-env DOTENV_ENV=development dotenvx run --convention=nextjs -- mikro-orm schema:fresh -r",
    "setup:kysely": "cross-env DOTENV_ENV=development dotenvx run --convention=nextjs -- kysely-codegen --out-file ./src/database/types/db.d.ts",
    "setup:seed": "cross-env DOTENV_ENV=development dotenvx run --convention=nextjs -- mikro-orm seeder:run",
    "setup:swagger": "ts-node src/generate-metadata.ts",
    "set-up": "npm run setup:db && npm run setup:kysely && npm run setup:swagger && npm run setup:seed"
  },
  "dependencies": {
    "@mikro-orm/core": "7.0.4",
    "@mikro-orm/decorators": "7.0.4",
    "@mikro-orm/entity-generator": "7.0.4",
    "@mikro-orm/migrations": "7.0.4",
    "@mikro-orm/nestjs": "7.0.1",
    "@mikro-orm/postgresql": "7.0.4",
    "@mikro-orm/reflection": "7.0.4",
    "@mikro-orm/seeder": "7.0.4",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "@nestjs/common": "11.1.16",
    "@nestjs/core": "11.1.16",
    "@nestjs/platform-express": "11.1.16",
    "@nestjs/swagger": "11.2.6",
    "@repo/utils": "workspace:*",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "express-session": "1.19.0",
    "jose": "6.2.2",
    "kysely": "0.28.11",
    "lodash-es": "4.17.23",
    "multer": "2.1.1",
    "nestjs-cls": "6.2.0",
    "nestjs-i18n": "10.6.0",
    "nestjs-kysely": "3.1.2",
    "nodemailer": "8.0.1",
    "otplib": "13.3.0",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.52.0",
    "@mikro-orm/cli": "7.0.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.16",
    "@repo/config": "workspace:*",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.18",
    "@swc/jest": "0.2.39",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/jest": "30.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/multer": "2.1.0",
    "@types/node": "25.3.5",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.18.0",
    "@types/supertest": "7.2.0",
    "cross-env": "10.1.0",
    "esbuild": "0.27.4",
    "esbuild-plugin-swc": "1.0.1",
    "eslint": "10.0.2",
    "jest": "29.7.0",
    "kysely-codegen": "0.20.0",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}