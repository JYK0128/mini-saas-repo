{
  "name": "@repo/utils",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "uuidv7": "1.1.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "24.12.0",
    "bunchee": "6.9.4",
    "eslint": "9.39.3",
    "typescript": "5.9.3"
  }
}